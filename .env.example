# Storage
QDRANT_PATH=storage/qdrant
QDRANT_COLLECTION=document_chunks
QDRANT_URL=
QDRANT_API_KEY=
CHUNK_CATALOG_PATH=storage/chunks.jsonl
UPLOAD_DIR=data/uploads
HF_HOME=storage/huggingface

# Embedding model: small, CPU-friendly, 384-dimensional sentence embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Chunking defaults (characters, not tokens)
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval pipeline
DENSE_TOP_K=20
BM25_TOP_K=20
RERANK_CANDIDATES=20
FINAL_TOP_K=5
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MIN_RERANK_SCORE=0.10
RRF_K=60
MAX_CONTEXT_CHARS=14000

# Generation: ollama is the recommended local default for this project.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=180

# Optional Hugging Face Transformers generator (larger RAM footprint):
TRANSFORMERS_GENERATION_MODEL=Qwen/Qwen2.5-1.5B-Instruct
GENERATION_MAX_NEW_TOKENS=450
GENERATION_TEMPERATURE=0.1
